/* Preferences — tabs */
"prefs_tab_music" = "Music";
"prefs_tab_dsp" = "DSP";
"prefs_no_path" = "No folder chosen yet…";
"prefs_choose_directory_title" = "Choose the music folder";
"prefs_dsp_explanation" = "Crossfeed mixes a little of the opposite channel, filtered, into each ear — as your head would if you were listening to speakers. It undoes the sense that the sound is inside your head. It applies to headphones only.";
"prefs_dsp_profile_label" = "Crossfeed strength:";
"prefs_dsp_profile_default" = "Light — 700 Hz / 4.5 dB";
"prefs_dsp_profile_cmoy" = "Medium — 700 Hz / 6.0 dB (C. Moy)";
"prefs_dsp_profile_jmeier" = "Strong — 650 Hz / 9.5 dB (Jan Meier)";
"prefs_dsp_note" = "The change takes effect at once: the sound goes quiet for a moment while the filter restarts. The headphones button in the main window turns the processing on and off without changing the volume, so the two can be compared. Through the speakers the audio always passes untreated.";
"prefs_tab_airplay" = "AirPlay";
"prefs_norm_explanation" = "Normalization evens out the volume between tracks, using the file's ReplayGain tags. It applies only to what goes out over AirPlay; on headphones and speakers each track plays at the level it was mastered at.";
"prefs_norm_label" = "Volume normalization:";
"prefs_norm_none" = "None — as it is in the file";
"prefs_norm_track" = "Per track — capped by the peak";
"prefs_norm_album" = "Per album — capped by the peak";
"prefs_norm_note" = "Both per-track options make everything equally loud, but flatten the level differences a record has on purpose; per album evens out records against each other and leaves the differences within one untouched, falling back to the track tags when the album ones are missing. “Full gain” applies what the tag says even if the peaks go past 0 dBFS and get clipped; “capped by the peak” reduces the gain to the most the track can take without clipping. Tracks with no tags at all play as they are.";
"prefs_norm_compensate" = "Compensate for the system volume attenuation";
"prefs_norm_note2" = "The system output is BlackHole, and its volume slider attenuates the audio before everything else — including before the stream. With this on, what goes out over AirPlay is always at the file's level, and the Mac slider governs the headphones only. The volume of the stereo is the stereo's business.";
"prefs_norm_track_full" = "Per track — full gain (may clip)";
"prefs_tab_eq" = "Headphones";
"prefs_eq_explanation" = "Equalization corrects the transducer's response: crossfeed models the head, this models the headphones. It applies to them only, and only with the processing on.";
"prefs_eq_label" = "Headphone model:";
"prefs_eq_none" = "No equalization";
"prefs_eq_builtin" = "Sony MDR-7506 (built in)";
"prefs_eq_open_folder" = "Open the corrections folder…";
"prefs_eq_note" = "The list comes from the AutoEQ project, using oratory1990's measurements against the Harman over-ear target: 522 models from 106 brands, stored in ~/Library/Application Support/tocaTintas/eq. To add another, drop its “ParametricEQ.txt” in the folder — at the top level or in a subfolder named after the brand — and it appears here. The “Preamp” line is read and honoured: it is what keeps the bass boost from overloading the output.";
"prefs_eq_brand" = "Brand:";
"prefs_eq_model" = "Model:";
"prefs_eq_mine" = "My own files";
"airplay_button_tooltip" = "AirPlay. ⌘-click reopens the session.";
