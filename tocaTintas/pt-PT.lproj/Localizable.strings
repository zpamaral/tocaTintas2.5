/* Preferências: CD de áudio */
"prefs_tab_cd" = "CD";
"prefs_cd_explanation" = "Quando metes um CD de áudio, o tocaTintas procura os nomes das faixas e a capa na tua fonoteca (pelo identificador CDDB ou MusicBrainz dos teus FLAC) e na internet: primeiro no MusicBrainz e, para os discos que ele não conhece, no gnudb (o antigo freedb).";
"prefs_cd_order_label" = "Ordem das fontes:";
"prefs_cd_order_none" = "Nenhuma (só «Faixa 1», «Faixa 2»…)";
"prefs_cd_order_local_internet" = "Fonoteca, depois internet";
"prefs_cd_order_internet_local" = "Internet, depois fonoteca";
"prefs_cd_note" = "O ganho ReplayGain vem sempre da fonoteca, quando o álbum lá está. As respostas da internet ficam guardadas, por isso cada disco só é pedido uma vez. O gnudb não tem capas.";
"prefs_cd_gnudb_email_label" = "Email para o gnudb (sem ele não se usa):";
"prefs_cd_gnudb_email_placeholder" = "tu@exemplo.pt";

/* Preferências e avisos: gravação */
"prefs_tab_recording" = "Gravação";
"prefs_rec_explanation" = "O botão ⏺️ grava para um ficheiro WAV, em vírgula flutuante de 32 bits, na pasta do tocaTintas em ~/Library/Application Support. Podes gravar tudo o que o Mac toca, ou só o som do app Música.";
"prefs_rec_source_label" = "Gravar:";
"prefs_rec_source_loopback" = "O que o Mac toca (BlackHole)";
"prefs_rec_source_music" = "O app Música (Dolby Atmos binaural)";
"prefs_rec_note" = "Para gravar o Dolby Atmos do Música, põe-no a tocar para os AirPods e, no menu do som da barra de menus, escolhe «Fixo» no áudio espacial. O Música faz então o binaural do Atmos, e é isso que fica gravado, em estéreo a 48 kHz. Com o seguimento da cabeça ligado, os teus movimentos ficavam no ficheiro; o tocaTintas avisa se der por isso. Para outras saídas, o Música entrega uma mistura estéreo comum. Na primeira gravação, o macOS pede autorização para gravar o áudio do Música e para ler o movimento dos AirPods.";
"rec_music_absent_title" = "O Música não está a tocar";
"rec_music_absent_text" = "Para gravar do Música, abre-o e põe uma faixa a tocar antes de carregares no ⏺️.";
"rec_music_failed_title" = "Não foi possível gravar o Música";
"rec_music_failed_text" = "O macOS não deixou captar o áudio do Música. Confirma em Definições do Sistema → Privacidade e segurança, na gravação do áudio do sistema, que o tocaTintas tem autorização.";
"rec_music_not_headphones_title" = "Isto não é o Dolby Atmos binaural";
"rec_music_not_headphones_text" = "O Música está a tocar para «%@». Só para os AirPods é que ele faz o binaural do Atmos; para esta saída, grava-se a mistura estéreo comum. A gravação continua.";
"rec_head_tracking_title" = "O seguimento da cabeça está a ficar gravado";
"rec_head_tracking_text" = "O som acompanha os movimentos da tua cabeça, e é assim que vai ficar no ficheiro. Com o Música a tocar para os AirPods, abre o menu do som da barra de menus, escolhe «Fixo» no áudio espacial e grava outra vez.";
"rec_loopback_silent_title" = "A gravação vai sair em silêncio";
"rec_loopback_silent_text" = "A saída do sistema é «%@», e não o BlackHole: o que lá tocar não entra na gravação. Para gravar o Música a tocar para os AirPods, escolhe a fonte «O app Música» no separador Gravação das preferências. A gravação continua.";
"rec_off_grid_title" = "A gravação não é bit-exacta";
"rec_off_grid_text" = "As amostras não caem nos degraus de 16 nem de 24 bits: o som está a ser recalculado antes de chegar ao BlackHole (agora a %.1f kHz). Causas habituais: o volume do Música abaixo do máximo, ou o equalizador, o Sound Check ou o crossfade ligados. A gravação continua.";
"rec_rate_failed_title" = "Não foi possível mudar a frequência do BlackHole";
"rec_rate_failed_text" = "O Música toca esta faixa a %.1f kHz, mas o BlackHole ficou a %.1f kHz: a gravação vai sair reamostrada. Podes mudá-la na Configuração de Áudio MIDI e gravar outra vez.";
"rec_rate_restore_failed_title" = "O BlackHole não voltou à frequência de antes";
"rec_rate_restore_failed_text" = "Ficou a %.1f kHz em vez de %.1f kHz. O tocaTintas volta a tentar no próximo arranque; também se pode mudar na Configuração de Áudio MIDI.";
"rec_album_end_title" = "Gravação terminada: fim do álbum";
"fonoteca_register_problems_title" = "Registo na fonoteca: houve problemas";
"fonoteca_register_failed_title" = "Registo na fonoteca: não correu";
"fonoteca_register_body" = "%@ — ver %@";
"prefs_rec_stop_album_end" = "Parar a gravação no fim do álbum";
"prefs_rec_stop_album_end_tip" = "Quando o Música passa a uma faixa de outro álbum, ou pára, a gravação pára sozinha e o BlackHole volta à frequência de antes. Desliga-se para gravar uma lista com faixas de vários álbuns.";
"rec_warning_ok" = "OK";

