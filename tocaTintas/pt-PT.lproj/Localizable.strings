/* Preferências — separadores */
"prefs_tab_music" = "Música";
"prefs_tab_dsp" = "DSP";
"prefs_no_path" = "Ainda não há pasta escolhida…";
"prefs_choose_directory_title" = "Escolher a pasta de música";
"prefs_dsp_explanation" = "O crossfeed mistura em cada ouvido um pouco do canal oposto, filtrado, como a cabeça faria se estivesse a ouvir colunas. Desfaz a sensação de o som estar dentro da cabeça. Aplica-se apenas aos auscultadores.";
"prefs_dsp_profile_label" = "Intensidade do crossfeed:";
"prefs_dsp_profile_default" = "Suave — 700 Hz / 4,5 dB";
"prefs_dsp_profile_cmoy" = "Médio — 700 Hz / 6,0 dB (C. Moy)";
"prefs_dsp_profile_jmeier" = "Forte — 650 Hz / 9,5 dB (Jan Meier)";
"prefs_dsp_note" = "A mudança tem efeito imediato: o som cala-se por um instante enquanto o filtro reinicia. O botão dos auscultadores, na janela principal, liga e desliga o tratamento sem alterar o volume, para poder comparar-se um com o outro. Nas colunas o áudio passa sempre sem tratamento.";
"prefs_tab_airplay" = "AirPlay";
"prefs_norm_explanation" = "A normalização iguala o volume entre faixas, a partir das etiquetas ReplayGain do ficheiro. Aplica-se apenas ao que sai para o AirPlay; nos auscultadores e nas colunas cada faixa toca ao nível a que foi masterizada.";
"prefs_norm_label" = "Normalização do volume:";
"prefs_norm_none" = "Nenhuma — como está no ficheiro";
"prefs_norm_track" = "Por faixa — limitado pelo pico";
"prefs_norm_album" = "Por álbum — limitado pelo pico";
"prefs_norm_note" = "As duas opções por faixa põem tudo ao mesmo volume, mas achatam as diferenças de nível que um disco tem de propósito; a de álbum iguala discos entre si e mantém intactas as diferenças lá dentro, recaindo na de faixa quando faltam as etiquetas de álbum. «Ganho integral» aplica o que a etiqueta manda, mesmo que os picos passem de 0 dBFS e sejam ceifados; «limitado pelo pico» reduz o ganho ao máximo que a faixa comporta sem ceifar. Faixas sem etiquetas nenhumas tocam como estão.";
"prefs_norm_compensate" = "Compensar a atenuação do volume do sistema";
"prefs_norm_note2" = "A saída do sistema é o BlackHole, e o seu cursor de volume atenua o áudio antes de tudo o resto — inclusive antes da transmissão. Com esta opção, o que sai para o AirPlay vai sempre ao nível do ficheiro, e o cursor do Mac passa a governar só os auscultadores. Quem manda no volume da aparelhagem é a aparelhagem.";
"prefs_norm_track_full" = "Por faixa — ganho integral (pode ceifar)";
"prefs_tab_eq" = "Auscultadores";
"prefs_eq_explanation" = "A equalização corrige a resposta do transdutor: o crossfeed modela a cabeça, esta modela os auscultadores. Aplica-se só a eles, e só com o tratamento ligado.";
"prefs_eq_label" = "Modelo de auscultadores:";
"prefs_eq_none" = "Sem equalização";
"prefs_eq_builtin" = "Sony MDR-7506 (embutida)";
"prefs_eq_open_folder" = "Abrir a pasta das correcções…";
"prefs_eq_note" = "A lista vem do projecto AutoEQ, com correcções para o alvo Harman over-ear: 523 modelos de 106 marcas, todos medidos pelo oratory1990 menos o Sony MDR-V600, que vem da Innerfidelity, guardados em ~/Library/Application Support/tocaTintas/eq. Para acrescentar outro, larga o ficheiro «ParametricEQ.txt» na pasta — na raiz ou numa subpasta com o nome da marca — e ele aparece aqui. A linha «Preamp» é lida e respeitada: é ela que impede o reforço de graves de saturar a saída.";
"prefs_eq_brand" = "Marca:";
"prefs_eq_model" = "Modelo:";
"prefs_eq_mine" = "Os meus ficheiros";
"airplay_button_tooltip" = "AirPlay. ⌘+clique reabre a sessão.";
"prefs_tab_pairing" = "Emparelhamento";
"prefs_pair_explanation" = "Alguns receptores AirPlay — o Apple TV 4K — só aceitam som de quem tiver feito com eles um emparelhamento. Faz-se uma vez: escolhe o aparelho, carrega em «Emparelhar» e escreve o código de quatro dígitos que aparece no ecrã. O HomePod e o Apple TV antigo não precisam disto e não aparecem na lista.";
"prefs_pair_device_label" = "Aparelho:";
"prefs_pair_none" = "Nenhum aparelho exige emparelhamento";
"prefs_pair_start" = "Emparelhar";
"prefs_pair_forget" = "Esquecer o emparelhamento";
"prefs_pair_code_label" = "Código mostrado no ecrã:";
"prefs_pair_confirm" = "Confirmar";
"prefs_pair_state_waiting" = "A aguardar o código que o aparelho mostra no ecrã…";
"prefs_pair_state_paired" = "Emparelhado. O aparelho aceita som do tocaTintas.";
"prefs_pair_state_unpaired" = "Ainda não emparelhado.";
"prefs_pair_state_failed" = "O emparelhamento falhou. O código estava certo? Tenta outra vez: o aparelho mostra um código novo.";
"prefs_pair_note" = "As credenciais ficam no porta-chaves deste Mac. Se repuseres o aparelho, o emparelhamento perde-se e é preciso fazê-lo de novo.";
"airplay_pairing_required_title" = "«%@» exige emparelhamento";
"airplay_pairing_required_text" = "Este aparelho só aceita som de quem tiver feito com ele um emparelhamento. Faz-se uma vez, em Preferências → Emparelhamento, com o código de quatro dígitos que aparece no ecrã.";
